# Dependencies
node_modules/
.pnp
.pnp.js
*/node_modules/

# Build artefacts
dist/
out/
*.tsbuildinfo
.wrangler/
.dev.vars
.dev.vars.local

# Python build
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# PyInstaller work output (keep the spec — CI needs it)
app/python/build/*
!app/python/build/pyinstaller.spec

# Electron build output
app/dist/
app/release/
app/.vite/

# Local app data
userData/
*.log
logs/
secrets.json

# Claude Code local state (per-machine)
.claude/

# OS + Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Env
.env
.env.local
.env.*.local

# Cert / Keys (never commit)
*.pem
*.key
private*.pem
*-private.pem

# Exception: public JWT key is required by the build (safe to commit)
!app/resources/jwt-public-key.pem
