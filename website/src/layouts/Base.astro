---
import '@/styles/global.css';
import Nav from '@components/Nav.astro';
import de from '@content/de.json';
import en from '@content/en.json';

type Props = {
  title?: string;
  description?: string;
  lang?: 'de' | 'en';
  bare?: boolean;
};

const lang = Astro.props.lang ?? 'de';
const dict = lang === 'de' ? de : en;

const title = Astro.props.title ?? dict.meta.title;
const description = Astro.props.description ?? dict.meta.description;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Sichtbarer On-Screen-Error-Logger (iOS-Debugging ohne USB/DevTools).
         Zeigt JS-Fehler direkt als rotes Overlay am unteren Rand. -->
    <script is:inline>
      window.__showErr = function (text) {
        var el = document.getElementById('err-log');
        if (!el) {
          // Fehler vor dem Body: zwischenspeichern, beim DOMContentLoaded ausgeben.
          (window.__errQueue = window.__errQueue || []).push(text);
          return;
        }
        el.style.display = 'block';
        var line = document.createElement('div');
        line.textContent = text;
        el.appendChild(line);
      };
      window.onerror = function (msg, src, lineNo) {
        window.__showErr(msg + ' (' + (src || '') + ':' + lineNo + ')');
      };
      window.onunhandledrejection = function (e) {
        window.__showErr('Promise: ' + (e.reason && (e.reason.message || e.reason)));
      };
      document.addEventListener('DOMContentLoaded', function () {
        if (window.__errQueue) window.__errQueue.forEach(window.__showErr);
      });
    </script>
    <meta name="theme-color" content="#5923c2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BillSorter" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://billsorter.app${Astro.url.pathname}`} />
    <meta property="og:image" content="https://billsorter.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://billsorter.app/og-image.png" />
    <link rel="preconnect" href="https://rsms.me" crossorigin />
  </head>
  <body class="bg-ink-950 text-white">
    <div id="err-log" style="display:none;position:fixed;bottom:0;left:0;right:0;background:red;color:white;font-size:12px;line-height:1.4;padding:8px;z-index:99999;max-height:200px;overflow-y:auto;font-family:monospace"></div>
    {!Astro.props.bare && <Nav lang={lang} />}
    <main>
      <slot />
    </main>

    <!-- Safety-Net OHNE Modul-Imports (is:inline) — kann nicht durch Import-Fehler brechen.
         Erzwingt nach 1.5s Sichtbarkeit aller Reveal-Elemente, falls eine Animation hängt. -->
    <script is:inline>
      setTimeout(function () {
        var els = document.querySelectorAll('.pain-line, .solution-line, .feature-card');
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          if (parseFloat(getComputedStyle(el).opacity) < 1) {
            el.style.opacity = '1';
            el.style.transform = 'none';
            el.style.clipPath = 'none';
          }
        }
      }, 1500);
    </script>

    <script>
      // i18n-Toggle (Modul-Script). Falls dieser Import auf iOS scheitert, bleibt die Seite
      // dank CSS-Defaults + is:inline-Safety-Net oben trotzdem voll sichtbar.
      import { hydrate, setLang, type Locale } from '@lib/i18n';
      try { hydrate(); } catch (e) { console.warn('i18n hydrate failed', e); }
      document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = btn.dataset.langBtn as Locale;
          try { setLang(next); } catch (e) { console.warn('setLang failed', e); }
        });
      });
    </script>
  </body>
</html>
