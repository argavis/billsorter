---
import de from '@content/de.json';
import en from '@content/en.json';
import BrandArrow from './icons/BrandArrow.astro';

type Props = { lang: 'de' | 'en' };
const { lang } = Astro.props;
const dict = lang === 'de' ? de : en;

const months = lang === 'de'
  ? ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August']
  : ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August'];

// SVG-Koordinaten für die Verbindungs-Linien.
// viewBox 0 0 500 600. Email-Card rechte Kante bei x=180, Mitte y=300.
// Folder-Reihe linke Kante bei x=320, Y-Positionen step 55 ab y=68.
const startX = 180;
const startY = 300;
const endX = 320;
const folderTop = 68;
const folderStep = 55;
---
<section
  id="solution"
  class="relative bg-brand-50 text-ink-900 py-32 lg:py-40 overflow-hidden"
>
  <!-- Decorative Arrow-Watermarks -->
  <div class="pointer-events-none absolute inset-0 opacity-50" aria-hidden="true">
    <div class="absolute top-[10%] right-[2%] text-brand-200" style="transform: rotate(-12deg);">
      <BrandArrow size={120} />
    </div>
    <div class="absolute bottom-[6%] left-[4%] text-brand-200" style="transform: rotate(28deg);">
      <BrandArrow size={70} />
    </div>
  </div>

  <div class="container-x relative">
    <div class="grid gap-12 lg:grid-cols-[1fr_500px] lg:gap-16">
      <!-- LEFT: Text -->
      <div class="max-w-xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-3 py-1 text-xs uppercase tracking-[0.18em] text-brand-700">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-600"></span>
          <span data-i18n-key="solution.kicker">{dict.solution.kicker}</span>
        </div>

        <div class="mt-16 space-y-2">
          <div
            class="solution-line text-[clamp(2rem,5vw,4rem)] font-bold tracking-tight leading-[1.05] text-ink-700"
            data-i18n-key="solution.line1"
          >
            {dict.solution.line1}
          </div>
          <div
            class="solution-line text-[clamp(2rem,5vw,4rem)] font-bold tracking-tight leading-[1.05] text-ink-800"
            data-i18n-key="solution.line2"
          >
            {dict.solution.line2}
          </div>
          <div
            class="solution-line text-[clamp(2rem,5vw,4rem)] font-bold tracking-tight leading-[1.05] text-ink-900"
            data-i18n-key="solution.line3"
          >
            {dict.solution.line3}
          </div>
        </div>

        <p class="mt-14 text-lg text-ink-700 sm:text-xl leading-relaxed text-balance" data-i18n-key="solution.body">
          {dict.solution.body}
        </p>

        <div class="mt-16 flex items-start gap-4">
          <span
            class="text-[clamp(2.5rem,6vw,5rem)] font-bold tracking-tight text-brand-600 leading-none"
            data-i18n-key="solution.punchline"
          >
            {dict.solution.punchline}
          </span>
          <span class="text-brand-600 mt-[0.1em]">
            <BrandArrow size={36} />
          </span>
        </div>
      </div>

      <!-- RIGHT: Visualisierung -->
      <div class="relative hidden lg:block" aria-hidden="true">
        <svg
          viewBox="0 0 500 600"
          class="absolute inset-0 h-full w-full"
          preserveAspectRatio="xMidYMid meet"
        >
          <defs>
            <filter id="sol-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="3" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
            <linearGradient id="sol-line" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%"  stop-color="#5923c2" stop-opacity="0.2" />
              <stop offset="50%" stop-color="#5923c2" stop-opacity="0.9" />
              <stop offset="100%" stop-color="#5923c2" stop-opacity="0.2" />
            </linearGradient>
          </defs>

          {months.map((_, i) => {
            const endY = folderTop + i * folderStep + 20; // 20 = vertical center of folder card
            // Cubic-Bezier mit Kontrollpunkten für S-Kurve
            const c1x = startX + 70;
            const c2x = endX - 70;
            const d = `M ${startX},${startY} C ${c1x},${startY} ${c2x},${endY} ${endX},${endY}`;
            const delay = (i * 0.25).toFixed(2);
            return (
              <g class="sol-path-group" style={`--delay: ${delay}s`}>
                <!-- Glow background path (dicker, niedrige opacity, blurred) -->
                <path
                  d={d}
                  fill="none"
                  stroke="#5923c2"
                  stroke-width="6"
                  stroke-linecap="round"
                  opacity="0.0"
                  filter="url(#sol-glow)"
                  class="sol-glow"
                />
                <!-- Sichtbare Linie -->
                <path
                  d={d}
                  fill="none"
                  stroke="#5923c2"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-dasharray="4 7"
                  opacity="0.65"
                  class="sol-line"
                />
                <!-- Endpunkt-Dot beim Folder -->
                <circle
                  cx={endX}
                  cy={endY}
                  r="3"
                  fill="#5923c2"
                  class="sol-dot"
                />
              </g>
            );
          })}
        </svg>

        <!-- Email-Card LEFT (statisch, vor SVG via z-index) -->
        <div class="absolute left-0 top-1/2 z-10 w-44 -translate-y-1/2 rounded-2xl border border-ink-200 bg-white p-4 shadow-lg">
          <div class="flex items-center gap-2 border-b border-ink-100 pb-3">
            <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-600 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M3 7 L12 13 L21 7" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold tracking-tight">Posteingang</div>
              <div class="text-[9px] uppercase tracking-wider text-ink-400">IMAP</div>
            </div>
          </div>
          <div class="mt-3 space-y-2">
            {[
              { from: 'Rechnung', amount: '47,11 €' },
              { from: 'Beleg', amount: '28,50 €' },
              { from: 'Invoice', amount: '15,00 €' },
              { from: 'Quittung', amount: '4,00 €' },
            ].map((m) => (
              <div class="flex items-center justify-between rounded-md bg-ink-50 px-2 py-1.5">
                <div class="flex items-center gap-1.5">
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
                  <span class="text-[10px] font-medium text-ink-700">{m.from}</span>
                </div>
                <span class="text-[10px] tabular-nums text-ink-500">{m.amount}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Folder-Stack RIGHT (statisch, vor SVG) -->
        <div class="absolute right-0 top-0 z-10 flex h-full flex-col justify-center gap-1.5">
          {months.map((m) => (
            <div class="flex w-44 items-center gap-2.5 rounded-lg border border-brand-200 bg-white px-3 py-1.5 shadow-sm">
              <div class="flex h-6 w-6 items-center justify-center rounded bg-brand-600/15 text-brand-700">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3 w-3">
                  <path d="M3 7 L3 19 L21 19 L21 9 L11 9 L9 7 Z" />
                </svg>
              </div>
              <div class="flex-1">
                <div class="text-[11px] font-semibold leading-none text-ink-900">{m}</div>
                <div class="text-[8px] uppercase tracking-wider text-ink-400">2026</div>
              </div>
              <span class="text-brand-500">
                <BrandArrow size={9} />
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Pulsierende Linien — Brand-Color glow + Dash-Flow.
     Jede sol-path-group hat individuelles --delay damit Pulse staggered laufen. */
  .sol-path-group .sol-line {
    animation: sol-pulse-opacity 2.8s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  .sol-path-group .sol-glow {
    animation: sol-pulse-glow 2.8s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  .sol-path-group .sol-dot {
    animation: sol-pulse-dot 2.8s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  .sol-line {
    /* Dash flow: dashes wandern entlang der Linie */
    animation-name: sol-pulse-opacity, sol-dash-flow;
    animation-duration: 2.8s, 3.5s;
    animation-iteration-count: infinite, infinite;
    animation-timing-function: ease-in-out, linear;
  }

  @keyframes sol-pulse-opacity {
    0%, 100% { opacity: 0.45; }
    50%      { opacity: 1.0;  }
  }
  @keyframes sol-pulse-glow {
    0%, 100% { opacity: 0.0; }
    50%      { opacity: 0.55; }
  }
  @keyframes sol-pulse-dot {
    0%, 100% { transform-origin: center; opacity: 0.5; r: 2; }
    50%      { opacity: 1; r: 4; }
  }
  @keyframes sol-dash-flow {
    from { stroke-dashoffset: 0;   }
    to   { stroke-dashoffset: -22; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sol-path-group .sol-line,
    .sol-path-group .sol-glow,
    .sol-path-group .sol-dot,
    .sol-line {
      animation: none !important;
    }
    .sol-path-group .sol-glow { opacity: 0.4; }
  }
</style>

<script>
  // Solution-Lines Reveal — additiv auf ALLEN Viewports, KEIN GSAP.
  // Zeilen per CSS sichtbar; IntersectionObserver fügt nur .reveal-play hinzu.
  // Schlägt JS/IO fehl, bleibt der Inhalt sichtbar.
  const prefersReduced = () =>
    typeof window !== 'undefined' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const setup = () => {
    const lines = Array.from(document.querySelectorAll<HTMLElement>('.solution-line'));
    if (lines.length === 0) return;
    if (prefersReduced()) return;
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-play');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    lines.forEach((el) => obs.observe(el));
  };

  if (document.readyState === 'complete') {
    requestAnimationFrame(setup);
  } else {
    window.addEventListener('load', () => requestAnimationFrame(setup), { once: true });
  }
</script>
