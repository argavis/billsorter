---
// KI-Erkennung — Chip mit Pin-Leitungen + Brand-Dreieck als AI-Core.
// Brand-Familie: 64×64, stroke=currentColor, outline, Logo-Dreieck als Akzent.
type Props = { class?: string };
const { class: cls = '' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`brand-icon ${cls}`}
  aria-hidden="true"
>
  <!-- Chip-Körper -->
  <rect x="14" y="14" width="36" height="36" rx="3" />
  <!-- Pin-Leitungen oben -->
  <line x1="22" y1="14" x2="22" y2="8" />
  <line x1="32" y1="14" x2="32" y2="8" />
  <line x1="42" y1="14" x2="42" y2="8" />
  <!-- Pin-Leitungen unten -->
  <line x1="22" y1="50" x2="22" y2="56" />
  <line x1="32" y1="50" x2="32" y2="56" />
  <line x1="42" y1="50" x2="42" y2="56" />
  <!-- Pin-Leitungen links -->
  <line x1="14" y1="22" x2="8" y2="22" />
  <line x1="14" y1="32" x2="8" y2="32" />
  <line x1="14" y1="42" x2="8" y2="42" />
  <!-- Pin-Leitungen rechts -->
  <line x1="50" y1="22" x2="56" y2="22" />
  <line x1="50" y1="32" x2="56" y2="32" />
  <line x1="50" y1="42" x2="56" y2="42" />
  <!-- Inner-Frame (subtle) -->
  <rect x="20" y="20" width="24" height="24" rx="2" stroke-dasharray="1.5 2" opacity="0.45" />
  <!-- Brand-Dreieck als AI-Core (Logo-Geometrie) -->
  <path class="ai-core" d="M26 40 L26 26 L40 40 Z" fill="currentColor" stroke="none" />
</svg>

<style>
  .brand-icon .ai-core {
    transform-origin: 33px 33px;
    animation: ai-core-pulse 2.6s ease-in-out infinite;
  }
  @keyframes ai-core-pulse {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-icon .ai-core { animation: none; }
  }
</style>
