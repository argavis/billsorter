---
import de from '@content/de.json';
import en from '@content/en.json';
import IconScan from './icons/IconScan.astro';
import IconAI from './icons/IconAI.astro';
import IconFolders from './icons/IconFolders.astro';
import IconProviders from './icons/IconProviders.astro';
import BrandArrow from './icons/BrandArrow.astro';

type Props = { lang: 'de' | 'en' };
const { lang } = Astro.props;
const dict = lang === 'de' ? de : en;

const features = [
  {
    key: 'f1', Icon: IconScan,
    title: dict.features.f1_title, body: dict.features.f1_body,
    bullets: [dict.features.f1_bullet1, dict.features.f1_bullet2, dict.features.f1_bullet3],
  },
  {
    key: 'f2', Icon: IconAI,
    title: dict.features.f2_title, body: dict.features.f2_body,
    bullets: [dict.features.f2_bullet1, dict.features.f2_bullet2, dict.features.f2_bullet3],
  },
  {
    key: 'f3', Icon: IconFolders,
    title: dict.features.f3_title, body: dict.features.f3_body,
    bullets: [dict.features.f3_bullet1, dict.features.f3_bullet2, dict.features.f3_bullet3],
  },
  {
    key: 'f4', Icon: IconProviders,
    title: dict.features.f4_title, body: dict.features.f4_body,
    bullets: [dict.features.f4_bullet1, dict.features.f4_bullet2, dict.features.f4_bullet3],
  },
];
---
<section
  id="features"
  class="relative overflow-hidden bg-ink-950 text-white"
>
  <div class="pointer-events-none absolute inset-0 opacity-25" aria-hidden="true">
    <div class="absolute top-[6%] right-[5%] text-brand-400" style="transform: rotate(-20deg);">
      <BrandArrow size={48} />
    </div>
  </div>

  <div class="container-x relative pt-32 pb-12">
    <span class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-400" data-i18n-key="features.kicker">
      {dict.features.kicker}
    </span>
    <h2 class="mt-3 max-w-3xl text-sect-1 font-bold tracking-tight text-balance" data-i18n-key="features.headline">
      {dict.features.headline}
    </h2>
  </div>

  <div id="features-pin" class="relative h-auto overflow-visible px-5 pb-16 md:h-[100dvh] md:overflow-hidden md:px-0 md:pb-0">
    <div id="features-rail" class="flex flex-col gap-6 md:h-full md:flex-row md:items-center md:gap-0 md:will-change-transform">
      {features.map((f, idx) => (
        <article
          class="feature-card group relative h-auto w-full shrink-0 md:h-[80dvh] md:w-screen md:px-12 md:sm:w-[80vw] md:lg:w-[70vw]"
          data-idx={idx}
        >
          <div class="relative flex h-full w-full flex-col items-start gap-8 overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] p-8 backdrop-blur-md md:flex-row md:items-center md:gap-12 md:p-12">
            <div class="pointer-events-none absolute -right-12 -bottom-12 text-brand-600/10" style="transform: rotate(15deg);">
              <BrandArrow size={300} />
            </div>

            <div class="relative flex-1">
              <div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-brand-400 md:text-xs">
                <span>{String(idx + 1).padStart(2, '0')} / 04</span>
                <BrandArrow size={10} />
              </div>
              <h3 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl" data-i18n-key={`features.${f.key}_title`}>
                {f.title}
              </h3>
              <p class="mt-6 max-w-xl text-lg text-white/70" data-i18n-key={`features.${f.key}_body`}>
                {f.body}
              </p>
              <ul class="mt-8 space-y-3.5 text-base text-white/80 md:text-sm">
                {f.bullets.map((b, i) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1.5 text-brand-400 shrink-0">
                      <BrandArrow size={10} />
                    </span>
                    <span data-i18n-key={`features.${f.key}_bullet${i + 1}`}>{b}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Icon: Mobile zentriert kleiner, Desktop groß rechts -->
            <div class="relative flex w-full items-center justify-center md:h-full md:w-1/2">
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="h-48 w-48 rounded-full bg-brand-600/25 blur-3xl md:h-80 md:w-80"></div>
              </div>
              <div class="relative flex h-44 w-44 items-center justify-center rounded-3xl border border-white/15 bg-white/[0.04] backdrop-blur-md transition-transform duration-700 group-hover:scale-105 md:h-80 md:w-80">
                <div class="h-28 w-28 md:h-48 md:w-48" style="color: #b393ec;">
                  <f.Icon class="h-full w-full" />
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="pointer-events-none absolute bottom-8 left-1/2 hidden -translate-x-1/2 gap-2 md:flex">
      {features.map((_, idx) => (
        <span class="features-dot block h-1 w-8 rounded-full bg-white/20 transition-all" data-idx={idx}></span>
      ))}
    </div>
  </div>
</section>

<script>
  // Features. Desktop: horizontaler Pin-Scroll via GSAP (dynamisch importiert).
  // Mobile/iOS: vertikaler Stack (CSS) + fade-in via IntersectionObserver, KEIN GSAP.
  const prefersReduced = () =>
    typeof window !== 'undefined' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = () =>
    typeof window !== 'undefined' &&
    (window.innerWidth < 768 || window.matchMedia('(pointer: coarse)').matches);
  const isIOS = () =>
    typeof navigator !== 'undefined' &&
    (/iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1));

  const revealAll = (cards: HTMLElement[]) =>
    cards.forEach((c) => { c.style.opacity = '1'; c.style.transform = 'none'; });

  // Additiv: Cards per CSS sichtbar, IO fügt nur .reveal-play hinzu.
  const setupMobileIO = () => {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.feature-card'));
    if (cards.length === 0) return;
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-play');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    cards.forEach((c) => obs.observe(c));
  };

  const setupDesktop = async () => {
    const { default: gsap } = await import('gsap');
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    gsap.registerPlugin(ScrollTrigger);
    const rail = document.getElementById('features-rail');
    const pin = document.getElementById('features-pin');
    if (!rail || !pin) return;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.feature-card'));
    if (cards.length === 0) return;
    const totalWidth = cards.reduce((sum, c) => sum + c.offsetWidth, 0);
    const distance = totalWidth - window.innerWidth;
    if (distance <= 0) { revealAll(cards); return; }
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.features-dot'));
    gsap.to(rail, {
      x: () => -distance,
      ease: 'none',
      scrollTrigger: {
        trigger: pin, pin: true, scrub: 1, start: 'top top',
        end: () => `+=${distance}`, invalidateOnRefresh: true,
        onUpdate: (self) => {
          const idx = Math.min(cards.length - 1, Math.floor(self.progress * cards.length));
          dots.forEach((d, i) => {
            const active = i === idx;
            d.style.width = active ? '40px' : '32px';
            d.style.backgroundColor = active ? 'rgba(180, 144, 255, 1)' : 'rgba(255, 255, 255, 0.2)';
          });
        },
      },
    });
    requestAnimationFrame(() => ScrollTrigger.refresh());
  };

  const setup = () => {
    if (prefersReduced()) return;
    if (isMobile() || isIOS()) { setupMobileIO(); return; }
    setupDesktop().catch((e) => {
      console.warn('features desktop failed', e);
      revealAll(Array.from(document.querySelectorAll<HTMLElement>('.feature-card')));
    });
  };

  if (document.readyState === 'complete') {
    requestAnimationFrame(setup);
  } else {
    window.addEventListener('load', () => requestAnimationFrame(setup), { once: true });
  }
</script>
