---
import de from '@content/de.json';
import en from '@content/en.json';
import IconClock from './icons/IconClock.astro';
import IconAlert from './icons/IconAlert.astro';
import IconMoney from './icons/IconMoney.astro';
import BrandArrow from './icons/BrandArrow.astro';

type Props = { lang: 'de' | 'en' };
const { lang } = Astro.props;
const dict = lang === 'de' ? de : en;
---
<section
  id="problem"
  data-bg="#fbfbfb"
  data-txt="#101116"
  class="relative bg-ink-50 text-ink-900 py-32 overflow-hidden"
>
  <!-- Dekorative Brand-Arrows als Background -->
  <div class="pointer-events-none absolute inset-0 opacity-50" aria-hidden="true">
    <div class="absolute top-[10%] right-[8%] text-brand-200" style="transform: rotate(-15deg);">
      <BrandArrow size={60} />
    </div>
    <div class="absolute bottom-[10%] left-[4%] text-brand-100" style="transform: rotate(20deg);">
      <BrandArrow size={80} />
    </div>
  </div>

  <div class="container-x relative">
    <div class="max-w-4xl">
      <h2 class="text-sect-1 font-bold text-balance">
        <span class="block fade-up text-ink-500" data-i18n-key="problem.headline_a">{dict.problem.headline_a}</span>
        <span class="block fade-up text-ink-500" data-i18n-key="problem.headline_b">{dict.problem.headline_b}</span>
        <span class="block fade-up text-brand-600" data-i18n-key="problem.headline_c">{dict.problem.headline_c}</span>
      </h2>
      <p class="mt-8 max-w-2xl text-lg text-ink-500 fade-up" data-i18n-key="problem.subline">{dict.problem.subline}</p>
    </div>

    <div class="mt-20 grid gap-6 md:grid-cols-3">
      <article class="fade-up group relative overflow-hidden rounded-2xl border border-ink-200 bg-white p-8 shadow-sm transition-all hover:border-brand-200 hover:shadow-md">
        <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-brand-50 transition-transform group-hover:scale-125"></div>
        <div class="relative h-12 w-12 text-brand-600">
          <IconClock class="h-12 w-12" />
        </div>
        <h3 class="mt-6 text-xl font-bold tracking-tight" data-i18n-key="problem.pain1_title">{dict.problem.pain1_title}</h3>
        <p class="mt-3 text-ink-500" data-i18n-key="problem.pain1_body">{dict.problem.pain1_body}</p>
      </article>

      <article class="fade-up group relative overflow-hidden rounded-2xl border border-ink-200 bg-white p-8 shadow-sm transition-all hover:border-brand-200 hover:shadow-md">
        <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-brand-50 transition-transform group-hover:scale-125"></div>
        <div class="relative h-12 w-12 text-brand-600">
          <IconAlert class="h-12 w-12" />
        </div>
        <h3 class="mt-6 text-xl font-bold tracking-tight" data-i18n-key="problem.pain2_title">{dict.problem.pain2_title}</h3>
        <p class="mt-3 text-ink-500" data-i18n-key="problem.pain2_body">{dict.problem.pain2_body}</p>
      </article>

      <article class="fade-up group relative overflow-hidden rounded-2xl border border-ink-200 bg-white p-8 shadow-sm transition-all hover:border-brand-200 hover:shadow-md">
        <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-brand-50 transition-transform group-hover:scale-125"></div>
        <div class="relative h-12 w-12 text-brand-600">
          <IconMoney class="h-12 w-12" />
        </div>
        <h3 class="mt-6 text-xl font-bold tracking-tight" data-i18n-key="problem.pain3_title">{dict.problem.pain3_title}</h3>
        <p class="mt-3 text-ink-500" data-i18n-key="problem.pain3_body">{dict.problem.pain3_body}</p>
      </article>
    </div>
  </div>
</section>
